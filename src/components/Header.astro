---
import { navLinks, navCta, isNavActive } from '../data/navigation';

const currentPath = Astro.url.pathname;
---

<header class="site-header" id="site-header">
  <div class="wrap site-header-inner">
    <a href="/" class="site-brand">
      <span class="site-mark" aria-hidden="true">🎧</span>
      <span class="site-brand-text">
        问情播客 <span class="site-brand-en">AskingLove</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="主导航">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={['site-nav-link', { 'is-active': isNavActive(link.href, currentPath) }]}
          aria-current={isNavActive(link.href, currentPath) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="site-header-actions">
      <a href={navCta.href} class="btn btn-primary site-header-cta">{navCta.label}</a>
      <button
        type="button"
        id="mobile-menu-btn"
        class="site-menu-btn"
        aria-label="打开菜单"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="site-menu-bar" id="bar1"></span>
        <span class="site-menu-bar" id="bar2"></span>
        <span class="site-menu-bar" id="bar3"></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="site-mobile-menu" hidden>
    <nav class="site-mobile-menu-inner" aria-label="移动导航">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={['site-mobile-link', { 'is-active': isNavActive(link.href, currentPath) }]}
          aria-current={isNavActive(link.href, currentPath) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
      <a href={navCta.href} class="btn btn-primary site-mobile-cta">{navCta.label}</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const bar1 = document.getElementById('bar1');
  const bar2 = document.getElementById('bar2');
  const bar3 = document.getElementById('bar3');

  if (btn && menu && bar1 && bar2 && bar3) {
    let open = false;

    const setOpen = (next) => {
      open = next;
      menu.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
      document.body.classList.toggle('site-menu-open', open);

      if (open) {
        bar1.style.transform = 'rotate(45deg) translate(2.5px, 2.5px)';
        bar2.style.opacity = '0';
        bar3.style.transform = 'rotate(-45deg) translate(2.5px, -2.5px)';
      } else {
        bar1.style.transform = '';
        bar2.style.opacity = '';
        bar3.style.transform = '';
      }
    };

    btn.addEventListener('click', () => setOpen(!open));

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && open) setOpen(false);
    });
  }
</script>
