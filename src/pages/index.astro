---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import { platforms } from '../data/platforms';
import { show } from '../data/show';
import { getPublishedEpisodes } from '../lib/rss';
import {
  episodeHref,
  formatEpisodeDate,
  getLatestEpisode,
  getStartHereEpisodes,
} from '../lib/episodes';
import { podcastSeriesJsonLd } from '../lib/jsonld';

const all = await getPublishedEpisodes();
const latest = getLatestEpisode(all);
const startHere = getStartHereEpisodes(all);
---

<BaseLayout
  title="问情播客 AskingLove"
  description={show.description}
>
  <JsonLd slot="head" data={podcastSeriesJsonLd(all.length)} />

  <!-- Hero -->
  <div class="wrap" style="padding-top:130px; padding-bottom:110px; text-align:center;">
    <div style="display:inline-block; padding:8px 14px; border-radius:999px; background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.08); color:#cec2d9; font-size:12px; letter-spacing:0.14em; text-transform:uppercase; margin-bottom:32px;">
      问情播客 AskingLove
    </div>
    <h1 style="margin:0 auto 42px; max-width:12ch; font-size:var(--text-5xl); line-height:1.06; letter-spacing:0.02em; font-weight:700; text-align:center;">
      <span style="display:block; text-align:center;">有些话，</span>
      <span style="display:block; text-align:center;">不知道该跟谁说。</span>
    </h1>
    <div style="max-width:720px; margin:0 auto; color:#cec2d9; font-size:var(--text-md); line-height:1.85;">
      这里聊心动、失望、拉扯，也聊那些你不知道该跟谁说的话。<br class="hidden-mobile">像一个会认真听你说话的朋友，陪你把乱成一团的情绪理清一点。
    </div>
    <div style="display:flex; gap:14px; justify-content:center; flex-wrap:wrap; margin-top:56px;">
      <a class="btn btn-primary" href={latest ? episodeHref(latest) : '/episodes'}>开始收听</a>
      <a class="btn btn-secondary" href="/submit">投稿你的故事</a>
    </div>
  </div>

  <!-- Light section -->
  <div class="light">
    <div class="wrap">

      <!-- Latest episode -->
      {latest && (
        <section id="latest">
          <div class="section-head">
            <div class="kicker">Latest</div>
            <h2>最新一集</h2>
          </div>
          <div class="card card-lg" style="overflow:hidden;">
            <div style="display:grid; grid-template-columns:320px 1fr;" class="feature-grid">
              <div style="min-height:360px; padding:28px; background:radial-gradient(circle at 22% 18%, rgba(255,132,124,0.18), transparent 24%), radial-gradient(circle at 78% 78%, rgba(199,155,230,0.10), transparent 24%), linear-gradient(180deg,#161021,#1d1428); color:white; display:flex; flex-direction:column; justify-content:space-between;" class="feature-cover">
                <small style="color:#a7d6ff; font-size:var(--text-xs); letter-spacing:0.12em; text-transform:uppercase;">Latest Episode</small>
                <strong style="font-family:var(--font-serif); font-size:var(--text-2xl); font-weight:600; line-height:1.3; letter-spacing:0.02em;">
                  {latest.title}
                </strong>
                <small style="color:#d8c6e6; font-size:var(--text-xs); letter-spacing:0.12em; text-transform:uppercase;">问情播客 AskingLove</small>
              </div>
              <div style="padding:40px 36px; display:flex; flex-direction:column; justify-content:center;" class="feature-copy">
                <div style="color:#9688a3; font-size:var(--text-xs); letter-spacing:0.04em; margin-bottom:14px;">
                  {[
                    latest.episodeNumber != null ? `第 ${latest.episodeNumber} 集` : null,
                    formatEpisodeDate(latest.pubDate),
                    latest.duration,
                  ].filter(Boolean).join(' · ')}
                </div>
                <div style="font-family:var(--font-serif); font-size:var(--text-2xl); line-height:1.3; letter-spacing:0.02em; margin-bottom:16px; font-weight:600;">
                  {latest.title}
                </div>
                <div style="color:#6d6376; font-size:var(--text-base); line-height:1.85; margin-bottom:22px;">
                  {latest.hook}
                </div>
                {latest.tags.length > 0 && (
                  <div style="display:flex; gap:10px; flex-wrap:wrap; margin-bottom:24px;">
                    {latest.tags.map((tag) => (
                      <span style="padding:6px 12px; border-radius:999px; background:rgba(141,81,187,0.06); color:#b49cc8; font-size:var(--text-xs);">{tag}</span>
                    ))}
                  </div>
                )}
                {latest.audioUrl && (
                  <div style="margin-bottom:22px;">
                    <AudioPlayer
                      src={latest.audioUrl}
                      type={latest.audioType}
                      title="本站收听"
                      downloadUrl={latest.audioUrl}
                    />
                  </div>
                )}
                <div style="display:flex; gap:12px; flex-wrap:wrap;">
                  <a class="btn btn-primary" style="padding:15px 26px; font-size:15px;" href={episodeHref(latest)}>查看这一集</a>
                  <a class="btn btn-light" style="padding:15px 26px; font-size:15px;" href="/episodes">全部节目</a>
                </div>
              </div>
            </div>
          </div>
        </section>
      )}

      <!-- Start Here pack -->
      {startHere.length > 0 && (
        <section id="start-here">
          <div class="section-head">
            <div class="kicker">Start Here</div>
            <h2>从这里开始听</h2>
            <div class="sub">不确定从哪一集开始？这几集是不错的入口。</div>
          </div>
          <div class="start-grid">
            {startHere.map((ep) => (
              <a href={episodeHref(ep)} class="start-card">
                <div class="start-meta">
                  {ep.episodeNumber != null && <span>第 {ep.episodeNumber} 集</span>}
                  {ep.duration && <span>{ep.duration}</span>}
                </div>
                <strong>{ep.title}</strong>
                <p>{ep.hook}</p>
                {ep.tags.length > 0 && (
                  <div class="start-tags">
                    {ep.tags.slice(0, 3).map((tag) => (
                      <span>{tag}</span>
                    ))}
                  </div>
                )}
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- About -->
      <section id="about">
        <div class="section-head">
          <div class="kicker">About</div>
          <h2>问情播客是什么？</h2>
          <div class="sub">
            你有没有过这样的深夜——翻来覆去睡不着，<br>脑子里全是那个人，也想不通自己为什么这么在意？
          </div>
        </div>
        <div style="display:grid; grid-template-columns:repeat(3, minmax(0,1fr)); gap:18px;" class="three-up">
          <div class="card about-card">
            <strong>不说教</strong>
            <p>不给标准答案，不告诉你"你应该怎样"。</p>
          </div>
          <div class="card about-card">
            <strong>不评判</strong>
            <p>接住那些你不知道该跟谁说的情绪。</p>
          </div>
          <div class="card about-card">
            <strong>像朋友一样</strong>
            <p>心动、失望、拉扯，都可以慢慢说。</p>
          </div>
        </div>
        <div style="text-align:center; margin-top:28px;">
          <a class="btn btn-light" href="/about" style="padding:14px 28px; font-size:15px;">了解更多关于我们</a>
        </div>
      </section>

      <!-- Belief -->
      <section>
        <div style="text-align:center; padding:74px 28px; border-radius:34px; background:radial-gradient(circle at 50% 10%, rgba(141,81,187,0.18), transparent 30%), linear-gradient(180deg,#171123,#110b18); color:white; box-shadow:0 22px 56px rgba(0,0,0,0.22);">
          <div style="max-width:24ch; margin:0 auto; font-size:var(--text-3xl); line-height:1.28; letter-spacing:0.02em;">
            爱是需要学习的能力，<br>
            而你愿意来到这里，<br>
            就已经迈出了最重要的一步。
          </div>
        </div>
      </section>

      <!-- Submit CTA -->
      <section id="submit">
        <div class="section-head">
          <div class="kicker">Submit Your Story</div>
          <h2>把你的故事讲给我们听</h2>
          <div style="max-width:760px; margin:0 auto 28px; color:#6d6376; text-align:center; line-height:1.85;">
            如果你也有一段不知道该跟谁说的感情经历，欢迎匿名投稿给问情播客。
          </div>
        </div>
        <div class="card card-lg" style="padding:38px 34px; background:linear-gradient(180deg,#fff,#f7f0fb); text-align:center;">
          <h3 style="margin:0 0 12px; font-size:var(--text-2xl); letter-spacing:-0.02em;">支持匿名投稿</h3>
          <p style="color:#6d6376; line-height:1.85; margin:0 0 32px;">投稿时不需要填写真实姓名或联系方式。</p>
          <a class="btn btn-primary" href="/submit" style="padding:16px 32px; font-size:16px;">开始投稿</a>
        </div>
      </section>

      <!-- Listen -->
      <section id="listen">
        <div class="section-head">
          <div class="kicker">Listen</div>
          <h2>在你习惯的平台收听</h2>
        </div>
        <div style="display:grid; grid-template-columns:repeat(2, minmax(0,1fr)); gap:18px;" class="listen-grid">
          {platforms.map((p) => (
            <a href={p.url} target="_blank" rel="noopener noreferrer" class="platform-card">
              <strong>{p.name}</strong>
              <span class="platform-arrow">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>
          ))}
        </div>
        <div style="text-align:center; margin-top:22px;">
          <a class="btn btn-light" href="/listen" style="padding:14px 28px; font-size:15px;">查看收听页</a>
        </div>
      </section>

      <!-- Newsletter -->
      <section id="signup" style="padding-bottom:56px;">
        <div class="newsletter-card">
          <h3 class="newsletter-title">不想错过问情播客的更新？</h3>
          <p class="newsletter-copy">订阅邮件，收到新节目、精选内容和最新动态。</p>
          <a href={show.substackUrl} target="_blank" rel="noopener noreferrer" class="newsletter-cta">
            在 Substack 订阅
          </a>
        </div>
      </section>
    </div>

    <Footer />
  </div>
</BaseLayout>

<style>
  .about-card {
    padding: 28px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 2px 8px rgba(18, 12, 28, 0.02) !important;
    border-color: rgba(44, 36, 51, 0.05) !important;
  }
  .about-card strong {
    display: block;
    font-size: 20px;
    margin-bottom: 10px;
    letter-spacing: -0.01em;
  }
  .about-card p {
    margin: 0;
    color: #6d6376;
    line-height: 1.8;
    font-size: 15px;
    flex: 1;
  }

  .start-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .start-card {
    display: block;
    padding: 24px;
    background: white;
    border: 1px solid rgba(44, 36, 51, 0.07);
    border-radius: 20px;
    box-shadow: 0 4px 14px rgba(18, 12, 28, 0.04);
    text-decoration: none;
    color: #2c2433;
    transition: all 0.2s ease;
  }
  .start-card:hover {
    border-color: rgba(141, 81, 187, 0.2);
    box-shadow: 0 10px 28px rgba(18, 12, 28, 0.09);
    transform: translateY(-2px);
  }
  .start-meta {
    display: flex;
    gap: 10px;
    font-size: 12px;
    color: #9688a3;
    margin-bottom: 10px;
  }
  .start-card strong {
    display: block;
    font-size: 18px;
    line-height: 1.35;
    margin-bottom: 8px;
    letter-spacing: -0.01em;
  }
  .start-card p {
    margin: 0;
    color: #6d6376;
    font-size: 14px;
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .start-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }
  .start-tags span {
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(141, 81, 187, 0.06);
    color: #b49cc8;
    font-size: 12px;
  }

  .platform-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 28px;
    min-height: 78px;
    background: white;
    border: 1px solid rgba(44, 36, 51, 0.07);
    border-radius: 20px;
    box-shadow: 0 4px 14px rgba(18, 12, 28, 0.04);
    text-decoration: none;
    color: #2c2433;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .platform-card strong {
    font-size: 18px;
    letter-spacing: -0.01em;
  }
  .platform-arrow {
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: rgba(141, 81, 187, 0.06);
    color: #8d51bb;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }
  .platform-card:hover {
    border-color: rgba(141, 81, 187, 0.20);
    box-shadow: 0 10px 28px rgba(18, 12, 28, 0.09);
    transform: translateY(-2px);
  }
  .platform-card:hover .platform-arrow {
    background: rgba(141, 81, 187, 0.12);
    transform: translateX(2px);
  }

  .newsletter-card {
    text-align: center;
    padding: 28px 32px 24px;
    background: white;
    border: 1px solid rgba(44, 36, 51, 0.06);
    border-radius: 20px;
    box-shadow: 0 2px 10px rgba(18, 12, 28, 0.025);
  }
  .newsletter-title {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #2c2433;
    margin: 0 0 10px;
  }
  .newsletter-copy {
    font-size: 16px;
    color: #6d6376;
    line-height: 1.8;
    margin: 0 0 18px;
  }
  .newsletter-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 40px;
    border-radius: 16px;
    background: linear-gradient(135deg, #8d51bb, #a66cd8);
    color: white;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 6px 16px rgba(141, 81, 187, 0.14);
    transition: all 0.2s ease;
  }
  .newsletter-cta:hover {
    box-shadow: 0 10px 22px rgba(141, 81, 187, 0.20);
    transform: translateY(-1px);
  }

  @media (max-width: 980px) {
    .feature-grid { grid-template-columns: 1fr !important; }
    .three-up { grid-template-columns: 1fr !important; }
  }
  @media (max-width: 720px) {
    .feature-cover { min-height: 240px !important; }
    .feature-copy { padding: 24px !important; }
    .listen-grid { grid-template-columns: 1fr !important; }
    .start-grid { grid-template-columns: 1fr !important; }
  }
  @media (max-width: 430px) {
    /* mobile type handled in global.css */
  }
  @media (prefers-reduced-motion: reduce) {
    .start-card, .platform-card { transition: none; }
  }
</style>
