---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import EpisodeCatalog from '../../components/EpisodeCatalog.tsx';
import { getPublishedEpisodes } from '../../lib/rss';
import { getAllTags, toEpisodeCardData } from '../../lib/episodes';

const allEpisodes = await getPublishedEpisodes();
const cards = allEpisodes.map(toEpisodeCardData);
const tags = getAllTags(allEpisodes);
const initialTag = Astro.url.searchParams.get('tag') || '';
---

<BaseLayout
  title="全部节目"
  description="浏览问情播客的所有节目。关于爱情、关系与情绪的中文播客。"
>
  <!-- Hero -->
  <div class="wrap" style="padding-top:110px; padding-bottom:56px; text-align:center;">
    <h1 style="margin:0 auto 16px; font-size:clamp(38px,5.8vw,58px); line-height:1.06; letter-spacing:-0.05em; font-weight:700;">
      全部节目
    </h1>
    <div style="color:#cec2d9; font-size:clamp(17px,2vw,19px); line-height:1.85;">
      每一集都是一段真实的情绪旅程。共 {allEpisodes.length} 集。
    </div>
  </div>

  <!-- Light section -->
  <div class="light" style="padding-top:64px;">
    <div class="wrap" style="max-width:640px;">
      <section style="padding-bottom:64px;">
        {allEpisodes.length > 0 ? (
          <EpisodeCatalog client:load episodes={cards} tags={tags} initialTag={initialTag} />
        ) : (
          <div style="text-align:center; padding:48px 0;">
            <p style="color:#6d6376; font-size:18px;">节目正在路上，敬请期待。</p>
          </div>
        )}
      </section>

      <!-- Newsletter -->
      <section style="padding-bottom:56px;">
        <div class="newsletter-card">
          <h3 class="newsletter-title">不想错过问情播客的更新？</h3>
          <p class="newsletter-copy">订阅邮件，收到新节目、精选内容和最新动态。</p>
          <a href="https://askinglovepod.substack.com" target="_blank" rel="noopener noreferrer" class="newsletter-cta">
            在 Substack 订阅
          </a>
        </div>
      </section>
    </div>

    <div style="padding-top:8px;">
      <Footer />
    </div>
  </div>
</BaseLayout>

<style>
  .newsletter-card {
    text-align: center;
    padding: 32px 32px;
    background: white;
    border: 1px solid rgba(44, 36, 51, 0.06);
    border-radius: 20px;
    box-shadow: 0 2px 10px rgba(18, 12, 28, 0.025);
  }
  .newsletter-title {
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #2c2433;
    margin: 0 0 12px;
  }
  .newsletter-copy {
    font-size: 15px;
    color: #9688a3;
    line-height: 1.8;
    margin: 0 0 24px;
  }
  .newsletter-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 15px 28px;
    border-radius: 16px;
    background: linear-gradient(135deg, #8d51bb, #a66cd8);
    color: white;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 6px 16px rgba(141, 81, 187, 0.14);
    transition: all 0.2s ease;
  }
  .newsletter-cta:hover {
    box-shadow: 0 10px 22px rgba(141, 81, 187, 0.20);
    transform: translateY(-1px);
  }
</style>
