---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';
import JsonLd from '../../components/JsonLd.astro';
import ShowNotesBlock from '../../components/ShowNotesBlock.astro';
import ShareBar from '../../components/ShareBar.tsx';
import { show } from '../../data/show';
import overridesJson from '../../data/episode-overrides.json';
import type { Episode, EpisodeOverride } from '../../lib/rss';
import { getPublishedEpisodes } from '../../lib/rss';
import {
  episodeHref,
  formatEpisodeDate,
  getEpisodeStaticPaths,
  getRelatedEpisodes,
  rehydrateEpisode,
  tagHasOtherEpisodes,
  tagHref,
} from '../../lib/episodes';
import { podcastEpisodeJsonLd } from '../../lib/jsonld';
import { buildShowNotes } from '../../lib/show-notes';
import { getEpisodePlatformLinks } from '../../lib/store-links';
import {
  buildYoutubeDescription,
  hasFullTranscript,
  transcriptHref,
} from '../../lib/transcripts';

export async function getStaticPaths() {
  return getEpisodeStaticPaths();
}

interface Props {
  episode: Episode;
}

const episode = rehydrateEpisode(Astro.props.episode);
const all = await getPublishedEpisodes();
const related = getRelatedEpisodes(episode, all, 3);
const formattedDate = formatEpisodeDate(episode.pubDate);
const canonicalUrl = new URL(episodeHref(episode), show.url).href;

const ov = (overridesJson as Record<string, EpisodeOverride>)[episode.rssId];
const showNotes = buildShowNotes(episode, related, ov);

/** Tags: link only when another episode shares the same tag. */
const tagItems = episode.tags.map((tag) => ({
  tag,
  href: tagHasOtherEpisodes(tag, episode.rssId, all) ? tagHref(tag) : null,
}));

const metaParts: string[] = [];
if (episode.episodeNumber != null) metaParts.push(`第 ${episode.episodeNumber} 集`);
if (formattedDate) metaParts.push(formattedDate);
if (episode.duration) metaParts.push(episode.duration);

const platformLinks = getEpisodePlatformLinks({
  rssId: episode.rssId,
  rssPageUrl: episode.rssPageUrl,
});

const canReadFull = hasFullTranscript(episode.rssId);
const fullTextHref = transcriptHref(episode);
const youtubeDescription = buildYoutubeDescription({
  episode,
  takeaways: showNotes.takeaways,
  useTranscriptUrl: true,
});

const sorted = all.slice().sort((a, b) => a.pubDate.getTime() - b.pubDate.getTime());
const idx = sorted.findIndex((ep) => ep.rssId === episode.rssId);
const prevEp = idx > 0 ? sorted[idx - 1] : undefined;
const nextEp = idx >= 0 && idx < sorted.length - 1 ? sorted[idx + 1] : undefined;
---

<BaseLayout
  title={episode.title}
  description={episode.summary || episode.hook}
  ogType="article"
  ogImage={episode.coverImage}
  canonicalUrl={canonicalUrl}
>
  <JsonLd slot="head" data={podcastEpisodeJsonLd(episode)} />

  <!-- Hero -->
  <div class="wrap" style="padding-top:105px; padding-bottom:44px; text-align:center;">
    {tagItems.length > 0 && (
      <div style="display:flex; gap:8px; justify-content:center; flex-wrap:wrap; margin-bottom:22px;">
        {tagItems.map(({ tag, href }) =>
          href ? (
            <a href={href} class="tag-chip tag-chip-link">
              #{tag}
            </a>
          ) : (
            <span class="tag-chip" title="目前只有这一集使用此标签">
              #{tag}
            </span>
          ),
        )}
      </div>
    )}
    <h1 style="margin:0 auto 18px; max-width:18ch; font-size:clamp(34px,5.4vw,54px); line-height:1.08; letter-spacing:-0.05em; font-weight:700;">
      {episode.title}
    </h1>
    {metaParts.length > 0 && (
      <div style="margin-top:4px; color:#a89ab5; font-size:13px; letter-spacing:0.04em;">
        {metaParts.join(' · ')}
      </div>
    )}
  </div>

  <!-- Light section -->
  <div class="light" style="padding-top:48px;">
    <div class="wrap" style="max-width:560px;">

      <!-- Native audio player -->
      {episode.audioUrl && (
        <section style="padding-bottom:28px;">
          <AudioPlayer
            src={episode.audioUrl}
            type={episode.audioType}
            title="本站收听"
            downloadUrl={episode.audioUrl}
          />
        </section>
      )}

      <!-- 阅读全文 / YouTube ops links -->
      <section style="padding-bottom:28px;">
        <div class="read-full-card">
          {canReadFull ? (
            <>
              <div>
                <strong>阅读全文</strong>
                <p>完整正文（阅读版），适合慢慢看。</p>
              </div>
              <a class="btn btn-primary" href={fullTextHref} style="padding:14px 22px; font-size:15px; white-space:nowrap;">
                阅读全文
              </a>
            </>
          ) : (
            <>
              <div>
                <strong>正文文稿</strong>
                <p>完整阅读版整理中。定稿后会出现在本页。</p>
              </div>
              <span class="read-full-soon">即将上线</span>
            </>
          )}
        </div>
      </section>

      <!-- Structured show notes -->
      <section style="padding-bottom:36px;">
        <ShowNotesBlock notes={showNotes} related={related} />
      </section>

      <!-- Share episode + show -->
      <section style="padding-bottom:48px;">
        <ShareBar
          client:visible
          episodeUrl={showNotes.episodeUrl}
          episodeTitle={episode.title}
          shareText={showNotes.shareText}
          showUrl={showNotes.showUrl}
          showShareText={showNotes.showShareText}
          submitUrl={showNotes.submitUrl}
        />
      </section>

      <!-- YouTube description helper (for ops / share) -->
      {canReadFull && (
        <section style="padding-bottom:40px;">
          <details class="yt-desc-box">
            <summary>YouTube 描述文案（短 · 可复制）</summary>
            <p class="yt-desc-hint">
              描述里只放短 hook + 链接，不要贴全文。字幕请用
              <code>npm run transcript:srt -- {episode.rssId}</code>
              导出后上传。
            </p>
            <pre class="yt-desc-pre">{youtubeDescription}</pre>
          </details>
        </section>
      )}

      <!-- Related episodes (cards) -->
      {related.length > 0 && (
        <section class="related-episodes" style="padding-bottom:48px;">
          <h2 style="font-size:clamp(22px,3vw,28px); letter-spacing:-0.03em; margin:0 0 18px; color:#2c2433; font-weight:700;">
            相关节目
          </h2>
          <div style="display:grid; gap:12px;">
            {related.map((rel) => (
              <a href={episodeHref(rel)} class="related-card">
                <div class="related-cover">
                  {rel.coverImage ? (
                    <img src={rel.coverImage} alt="" loading="lazy" width="56" height="56" />
                  ) : (
                    <span>问</span>
                  )}
                </div>
                <div class="related-content">
                  <strong>{rel.title}</strong>
                  {(rel.episodeNumber != null || rel.duration) && (
                    <span class="related-meta">
                      {rel.episodeNumber != null ? `第 ${rel.episodeNumber} 集` : ''}
                      {rel.episodeNumber != null && rel.duration ? ' · ' : ''}
                      {rel.duration || ''}
                    </span>
                  )}
                </div>
                <div class="related-arrow">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- CTA: submit + subscribe -->
      <section style="padding-bottom:48px;">
        <div class="cta-stack">
          <div class="submit-card">
            <h3 class="newsletter-title">把你的故事讲给我们听</h3>
            <p class="newsletter-copy">有一段不知道该跟谁说的感情经历？欢迎匿名投稿。</p>
            <a href="/submit" class="btn btn-primary" style="padding:15px 24px; font-size:15px;">
              投稿你的故事
            </a>
          </div>
          <div class="newsletter-card">
            <h3 class="newsletter-title">不想错过问情播客的更新？</h3>
            <p class="newsletter-copy">订阅邮件，收到新节目、精选内容和最新动态。</p>
            <a href={show.substackUrl} target="_blank" rel="noopener noreferrer" class="newsletter-cta">
              在 Substack 订阅
            </a>
          </div>
        </div>
      </section>

      <!-- Platforms (deep links when available) -->
      <section style="padding-bottom:40px;">
        <div style="text-align:center; margin-bottom:16px;">
          <h2 style="font-size:clamp(22px,3vw,28px); letter-spacing:-0.03em; margin:0 0 6px; color:#2c2433; font-weight:700;">在其他平台收听</h2>
          <p style="color:#8a7d96; font-size:14px; margin:0;">Spotify / Apple 支持直达本集（若已匹配）。</p>
        </div>
        <div style="display:grid; gap:14px;" class="platform-grid">
          {platformLinks.map((p) => (
            <a href={p.url} target="_blank" rel="noopener noreferrer" class="platform-card">
              <span class="platform-card-text">
                <strong>{p.label}</strong>
                {p.deep && <small class="platform-deep">本集链接</small>}
              </span>
              <span class="platform-arrow">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>
          ))}
        </div>
      </section>

      <!-- Prev / next -->
      {(prevEp || nextEp) && (
        <section style="padding-bottom:64px;">
          <div class="prev-next">
            {prevEp ? (
              <a href={episodeHref(prevEp)} class="pn-card">
                <span class="pn-label">上一集</span>
                <strong>{prevEp.title}</strong>
              </a>
            ) : <div />}
            {nextEp ? (
              <a href={episodeHref(nextEp)} class="pn-card pn-next">
                <span class="pn-label">下一集</span>
                <strong>{nextEp.title}</strong>
              </a>
            ) : <div />}
          </div>
        </section>
      )}

    </div>

    <div style="padding-top:8px;">
      <Footer />
    </div>
  </div>
</BaseLayout>

<style>
  .tag-chip {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.08);
    color: #cec2d9;
    font-size: 12px;
    text-decoration: none;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .tag-chip-link {
    cursor: pointer;
  }
  .tag-chip-link:hover {
    color: white;
    border-color: rgba(199, 155, 230, 0.45);
    background: rgba(141, 81, 187, 0.18);
  }
  .read-full-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding: 20px 22px;
    background: white;
    border: 1px solid rgba(44, 36, 51, 0.07);
    border-radius: 20px;
    box-shadow: 0 4px 14px rgba(18, 12, 28, 0.04);
  }
  .read-full-card strong {
    display: block;
    font-size: 17px;
    color: #2c2433;
    margin-bottom: 6px;
  }
  .read-full-card p {
    margin: 0;
    font-size: 14px;
    color: #6d6376;
    line-height: 1.65;
    max-width: 36ch;
  }
  .read-full-soon {
    font-size: 13px;
    font-weight: 600;
    color: #9688a3;
    padding: 10px 14px;
    border-radius: 999px;
    background: rgba(141, 81, 187, 0.06);
  }
  .yt-desc-box {
    padding: 16px 18px;
    border-radius: 16px;
    background: #f7f0fb;
    border: 1px solid rgba(141, 81, 187, 0.12);
    color: #2c2433;
  }
  .yt-desc-box summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 15px;
  }
  .yt-desc-hint {
    margin: 12px 0;
    font-size: 13px;
    color: #6d6376;
    line-height: 1.65;
  }
  .yt-desc-hint code {
    font-size: 12px;
    background: rgba(141, 81, 187, 0.08);
    padding: 2px 6px;
    border-radius: 6px;
  }
  .yt-desc-pre {
    margin: 0;
    padding: 14px;
    border-radius: 12px;
    background: white;
    border: 1px solid rgba(44, 36, 51, 0.08);
    font-size: 13px;
    line-height: 1.65;
    white-space: pre-wrap;
    word-break: break-word;
    color: #3d3448;
  }
  .notes-body p {
    margin: 0 0 1.1em;
    color: #6d6376;
    font-size: 16px;
    line-height: 1.9;
  }
  .notes-body p:last-child {
    margin-bottom: 0;
  }
  .notes-empty p {
    margin: 0;
    color: #9688a3;
    font-size: 15px;
    text-align: center;
    padding: 12px 0;
  }

  .related-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    background: white;
    border: 1px solid rgba(44, 36, 51, 0.07);
    border-radius: 16px;
    box-shadow: 0 4px 14px rgba(18, 12, 28, 0.04);
    text-decoration: none;
    color: #2c2433;
    transition: all 0.2s ease;
  }
  .related-cover {
    width: 56px;
    height: 56px;
    border-radius: 12px;
    overflow: hidden;
    background: radial-gradient(circle at 30% 20%, rgba(255,132,124,0.12), transparent 40%), linear-gradient(135deg, #161021, #1d1428);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: rgba(199,155,230,0.5);
    font-size: 18px;
  }
  .related-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .related-content {
    flex: 1;
    min-width: 0;
  }
  .related-content strong {
    display: block;
    font-size: 15px;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }
  .related-meta {
    display: block;
    margin-top: 4px;
    font-size: 12px;
    color: #9688a3;
  }
  .related-arrow {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: rgba(141, 81, 187, 0.07);
    color: #8d51bb;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }
  .related-card:hover {
    border-color: rgba(141, 81, 187, 0.22);
    box-shadow: 0 10px 28px rgba(18, 12, 28, 0.10);
    transform: translateY(-2px);
  }
  .related-card:hover .related-arrow {
    background: rgba(141, 81, 187, 0.14);
    transform: translateX(2px);
  }

  .cta-stack {
    display: grid;
    gap: 16px;
  }
  .newsletter-card,
  .submit-card {
    text-align: center;
    padding: 36px 32px;
    background: white;
    border: 1px solid rgba(44, 36, 51, 0.06);
    border-radius: 20px;
    box-shadow: 0 2px 10px rgba(18, 12, 28, 0.025);
  }
  .newsletter-title {
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #2c2433;
    margin: 0 0 14px;
  }
  .newsletter-copy {
    font-size: 15px;
    color: #9688a3;
    line-height: 1.8;
    margin: 0 0 28px;
  }
  .newsletter-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 15px 24px;
    border-radius: 16px;
    background: linear-gradient(135deg, #8d51bb, #a66cd8);
    color: white;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(141, 81, 187, 0.10);
    transition: all 0.2s ease;
  }
  .newsletter-cta:hover {
    box-shadow: 0 8px 18px rgba(141, 81, 187, 0.16);
    transform: translateY(-1px);
  }

  .platform-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 24px;
    min-height: 72px;
    background: white;
    border: 1px solid rgba(44, 36, 51, 0.08);
    border-radius: 18px;
    box-shadow: 0 4px 14px rgba(18, 12, 28, 0.04);
    text-decoration: none;
    color: #2c2433;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .platform-card-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .platform-card strong {
    font-size: 16px;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .platform-deep {
    font-size: 12px;
    font-weight: 500;
    color: #8d6ba3;
  }
  .platform-arrow {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: rgba(141, 81, 187, 0.07);
    color: #8d51bb;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }
  .platform-card:hover {
    border-color: rgba(141, 81, 187, 0.22);
    box-shadow: 0 10px 28px rgba(18, 12, 28, 0.10);
    transform: translateY(-2px);
  }
  .platform-card:hover .platform-arrow {
    background: rgba(141, 81, 187, 0.14);
    transform: translateX(2px);
  }

  .prev-next {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .pn-card {
    display: block;
    padding: 16px 18px;
    border-radius: 16px;
    background: white;
    border: 1px solid rgba(44, 36, 51, 0.07);
    text-decoration: none;
    color: #2c2433;
    transition: border-color 0.15s;
  }
  .pn-card:hover {
    border-color: rgba(141, 81, 187, 0.22);
  }
  .pn-next {
    text-align: right;
  }
  .pn-label {
    display: block;
    font-size: 12px;
    color: #9688a3;
    margin-bottom: 6px;
  }
  .pn-card strong {
    font-size: 14px;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 600px) {
    .prev-next { grid-template-columns: 1fr; }
    .pn-next { text-align: left; }
  }
</style>
